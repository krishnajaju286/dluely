# ==========================================
# DLUELY - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini API (Recommended for live meeting audio + ultra-fast response)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Local Offline LLM Support via Ollama (Optional)
# Set to 'true' if you want 100% offline text/code solving with local models
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2 # (Leave blank to auto-detect installed models)

# 3. Developer / Mock Settings (Optional)
NODE_ENV=development
IS_DEV_TEST=false
MOCK_API_WAIT_TIME=500
